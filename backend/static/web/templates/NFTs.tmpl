		<!-- main content -->
		<main class="main" id="content">
			<div class="container">
				<div class="row row--grid">
					<!-- title -->
					<div class="col-12" v-if="keywords">
						<div class="main__title main__title--page">
							<h1>
								{{total}}
								<span v-if="total > 1" class="i18n" name="">{{$.i18n.prop('nfts-records')}}</span>
                                <span v-else class="i18n" name="nfts-record">{{$.i18n.prop('nfts-record')}}</span>
							</h1>
						</div>
					</div>
					<!-- end title -->

					<!-- tabs nav -->
					<div class="col-12">
						<ul class="nav nav-tabs main__tabs" id="main__tabs" role="tablist">
							<li class="nav-item" v-for="(item,i) in navList" :key="i" @click="changeNavItem(item.id)">
								<a class="nav-link" :class="{'active': i == 0}" data-toggle="tab" :href="'#tab-'+(i+1)" role="tab"
									aria-controls="tab-1" aria-selected="true">{{item.categoryName}}</a>
							</li>
						</ul>
					</div>
					<!-- end tabs nav -->
				</div>

				<!-- tabs content -->
				<div class="tab-content">
					<div v-for="(item, i) in navList" :key="i" class="tab-pane fade" :class="{'show active': i == 0}"  :id="'tab-'+(i+1)" role="tabpanel">
						<div class="row row--grid">


							<div class="col-12 col-sm-6 col-lg-4 col-xl-3" v-for="(subItem, j) in cardlist" :key="j">
								<!-- carousel card -->
								<div class="card" >
									<div v-if="subItem.collectionUri" class="card__cover card__cover--carousel owl-carousel" onclick="linkToDetail(subItem.uri)">
										<img src="/static/web/img/cover/slide1.jpg" alt="">
										<img src="/static/web/img/cover/slide2.jpg" alt="">
										<img src="/static/web/img/cover/slide3.jpg" alt="">
									</div>
									<a v-else :href="'/detail/'+subItem.uri" class="card__cover open-modal">
										<img :src="subItem.cover +'/640'" alt="">
									</a>
									<h3 class="card__title">
										<a :href="'/detail/'+subItem.uri">{{subItem.title}}</a>
									</h3>
									<div class="card__author">
										<img :src="subItem.owner?.avatar +'/640'" alt=""  :style="{background:'url('+subItem.owner?.avatar+'/640) center center / contain no-repeat'}">
										<a :href="'/profile/'+subItem.owner?.wallet">{{subItem.owner.userName}}</a>
									</div>
									<div class="card__info">
										<div class="card__price">
											<span>{{$.i18n.prop('common-price')}}</span>
											<span>{{(subItem.price / 1000000000000000000)}}
											<template v-if="subItem.contract_type == 0">ETH</template>
                                             <template v-else>TAIL</template>
											</span>
										</div>

										<button class="card__likes" type="button" v-on:click="heartClick(subItem.uri,j)">
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" :class="{'heart_active': subItem.isLike}">
												<path
													d="M20.16,5A6.29,6.29,0,0,0,12,4.36a6.27,6.27,0,0,0-8.16,9.48l6.21,6.22a2.78,2.78,0,0,0,3.9,0l6.21-6.22A6.27,6.27,0,0,0,20.16,5Zm-1.41,7.46-6.21,6.21a.76.76,0,0,1-1.08,0L5.25,12.43a4.29,4.29,0,0,1,0-6,4.27,4.27,0,0,1,6,0,1,1,0,0,0,1.42,0,4.27,4.27,0,0,1,6,0A4.29,4.29,0,0,1,18.75,12.43Z" />
											</svg>
											<span>{{subItem.like_num}}</span>
										</button>
									</div>
								</div>
							</div>

							<div class="col-12" v-show="!isEnd">
								<button class="main__load" type="button" data-toggle="collapse"
									data-target="#collapsemore1" aria-expanded="false"
									aria-controls="collapsemore1" v-on:click="getCardList()">{{$.i18n.prop('common-loadmore')}}</button>
							</div>
							<!-- end collapse -->
						</div>
					</div>
				</div>
				<!-- end tabs content -->
			</div>
			</div>
		</main>
		<!-- end main content -->


		<!-- Toast 用来显示请求的提示信息-->
		<div class="toast" role="alert" aria-live="assertive" aria-atomic="true">
			<div class="toast-header">
				Hello, world! This is a toast message.
			</div>
			<div class="toast-body">
				Hello, world! This is a toast message.Hello, world! This is a toast message.
			</div>
		</div>
		<!-- end Toast -->


		<!--Modal 用来显示需要确认的信息-->
		<div class="modal" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Modal title</h5>
						<button type="button" class="close" onclick="hideModal()" data-dismiss="modal"
							aria-label="Close">
							<span aria-hidden="true">&times;</span>
						</button>
					</div>
					<div class="modal-body">
						<p>Modal body text goes here.</p>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary i18n" name="toast-cancel" onclick="hideModal()" data-dismiss="modal" >Close</button>
					</div>
				</div>
			</div>
		</div>

		<!-- end Modal -->

