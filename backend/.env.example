# 复制为 .env 并填写真实值；.env 不要提交到仓库
# dev | test | prod
ENV=dev
HOST=
PORT=8000
# 反向代理地址，逗号分隔；留空表示不信任任何 X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1

# JWT：生产环境必须设置 ≥32 位随机串，例如 `openssl rand -hex 32`
JWT_SECRET=
JWT_ISSUER=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=beihai
DB_PASSWORD=
DB_DATABASE=beihai
DB_CHARSET=utf8mb4

# Redis / RabbitMQ
REDIS_ADDR=127.0.0.1:6379
RABBITMQ_URL=amqp://user:password@127.0.0.1:5672/bh

# 汇付天下企账通（测试环境默认 testpnr，ENV=prod 默认 cloudpnr）
HF_MER_CUST_ID=
HF_DIV_ACCT_ID=
HF_DIV_CUST_ID=
HF_PFX_FILE=
HF_PFX_PASSWORD=
HF_CERT_FILE=
HF_RET_URL=https://your-h5-domain/payreturn.html?type=1
HF_BG_RET_URL=https://your-api-domain/api/v1/pay/notify
HF_WALLET_BG_RET_URL=https://your-api-domain/api/v1/wallet/notify
HF_BALANCE_BG_RET_URL=https://your-api-domain/api/v1/balance-pay/notify
HF_MAKE_SIGN_URL=http://127.0.0.1:8080/hfpcfca/cfca/makeSign
HF_VERIFY_SIGN_URL=http://127.0.0.1:8080/hfpcfca/cfca/verifySign

# BSN 文昌链 / AVATA（ENV=prod 默认正式环境地址）
AVATA_URL=
AVATA_API_KEY=
AVATA_API_SECRET=
AVATA_CLASS_ID=

# 腾讯云 COS（头像上传）
COS_BUCKET=
COS_BUCKET_URL=https://<bucket>.cos.<region>.myqcloud.com
COS_SECRET_ID=
COS_SECRET_KEY=

# 阿里云市场 APPCODE（短信 + 实名认证）
ALIYUN_MARKET_APPCODE=

# 可选
MORALIS_API_KEY=
DEFAULT_AVATAR_URL=
# 仅 backend/test/main.go 调试脚本使用
ETH_PRIVATE_KEY=
